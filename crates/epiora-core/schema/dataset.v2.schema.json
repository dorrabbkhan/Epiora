{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Epiora dataset JSON v2",
  "description": "Dataset model v2 (v1.1 spec §4.3): the v1 corpus dataset plus `time`/`date_time` column types, per-column `meta` (prompt, legacy type/name, label-set id — never hashed but `label_set` references are) and top-level `label_sets` (part of the hash). Task 4 copies this file under `fixtures/schema/` for its golden imports.",
  "type": "object",
  "required": ["id", "version", "columns"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/column"
      }
    },
    "label_sets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/label_set"
      }
    }
  },
  "definitions": {
    "column": {
      "type": "object",
      "required": ["name", "type", "values"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": ["integer", "real", "text", "boolean", "date", "time", "date_time"]
        },
        "values": {
          "type": "array"
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prompt": { "type": "string" },
            "legacy_type": { "type": "string" },
            "legacy_name": { "type": "string" },
            "label_set": { "type": "string", "minLength": 1 }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": { "const": "integer" }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "values": {
                "type": "array",
                "items": { "type": ["integer", "null"] }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "real" }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "values": {
                "type": "array",
                "items": { "type": ["number", "null"] }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "text" }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "values": {
                "type": "array",
                "items": { "type": ["string", "null"] }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "boolean" }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "values": {
                "type": "array",
                "items": { "type": ["boolean", "null"] }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "date" }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "values": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                    },
                    { "type": "null" }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "time" }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "values": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$"
                    },
                    { "type": "null" }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "date_time" }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "values": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$"
                    },
                    { "type": "null" }
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "label_set": {
      "type": "object",
      "required": ["id", "entries"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              { "$ref": "#/definitions/labeled_value" },
              { "type": "string" }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "labeled_value": {
      "type": "object",
      "required": ["type", "value"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["integer", "real", "text", "boolean", "date", "time", "date_time"]
        },
        "value": true
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "integer" } }, "required": ["type"] },
          "then": { "properties": { "value": { "type": "integer" } } }
        },
        {
          "if": { "properties": { "type": { "const": "real" } }, "required": ["type"] },
          "then": { "properties": { "value": { "type": "number" } } }
        },
        {
          "if": { "properties": { "type": { "const": "text" } }, "required": ["type"] },
          "then": { "properties": { "value": { "type": "string" } } }
        },
        {
          "if": { "properties": { "type": { "const": "boolean" } }, "required": ["type"] },
          "then": { "properties": { "value": { "type": "boolean" } } }
        },
        {
          "if": { "properties": { "type": { "const": "date" } }, "required": ["type"] },
          "then": { "properties": { "value": { "type": "integer" } } }
        },
        {
          "if": { "properties": { "type": { "const": "time" } }, "required": ["type"] },
          "then": { "properties": { "value": { "type": "integer", "minimum": 0, "maximum": 86399 } } }
        },
        {
          "if": { "properties": { "type": { "const": "date_time" } }, "required": ["type"] },
          "then": { "properties": { "value": { "type": "integer" } } }
        }
      ]
    }
  }
}
