*** functions_date.pgm — Epiora v1.1 Task 3 reference program.
*** Date functions over Oswego12's real Access datetime columns: DATEONSET
*** (missing in 29 rows) and TIMESUPPER (missing in 47) — missing inputs
*** propagate to every result. TXTTODATE for a fixed comparison date,
*** NUMTODATE/NUMTOTIME to build values, DAYS between supper and onset.
READ '@WORK_DIR@/Sample.mdb':Oswego12
ROUTEOUT "@OUTPUT_HTML@" REPLACE
DEFINE ONYEAR NUMERIC
ASSIGN ONYEAR = YEAR(DATEONSET)
FREQ ONYEAR
DEFINE ONMONTH NUMERIC
ASSIGN ONMONTH = MONTH(DATEONSET)
FREQ ONMONTH
DEFINE ONDAY NUMERIC
ASSIGN ONDAY = DAY(DATEONSET)
FREQ ONDAY
DEFINE ONHOUR NUMERIC
ASSIGN ONHOUR = HOUR(TIMESUPPER)
FREQ ONHOUR
DEFINE INCMIN NUMERIC
ASSIGN INCMIN = MINUTES(TIMESUPPER, DATEONSET)
FREQ INCMIN
DEFINE INCUB NUMERIC
ASSIGN INCUB = DAYS(TIMESUPPER, DATEONSET)
MEANS INCUB
DEFINE NYRS NUMERIC
ASSIGN NYRS = YEARS(DATEONSET, TXTTODATE("04/19/1940"))
FREQ NYRS
DEFINE NMON NUMERIC
ASSIGN NMON = MONTHS(DATEONSET, TXTTODATE("04/19/1940"))
FREQ NMON
DEFINE NDATE DATEFORMAT
ASSIGN NDATE = NUMTODATE(1940, 4, 19)
LIST NDATE
DEFINE NTIME TIMEFORMAT
ASSIGN NTIME = NUMTOTIME(18, 30, 0)
LIST NTIME
CLOSEOUT
QUIT
