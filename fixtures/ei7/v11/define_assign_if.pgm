*** define_assign_if.pgm — Epiora v1.1 Task 3 reference program.
*** DEFINE (typed and define-expression forms), ASSIGN, LET-style simple
*** assign, IF/THEN/ELSE/END, UNDEFINE, and missing-value propagation in
*** arithmetic (BIGPLUS = BIGAGE + 1 where BIGAGE is missing for AGE <= 60).
*** Pins spec §15.2: missing values in comparisons and arithmetic.
READ '@WORK_DIR@/Sample.mdb':Oswego12
ROUTEOUT "@OUTPUT_HTML@" REPLACE
DEFINE AGEX2 NUMERIC
ASSIGN AGEX2 = AGE * 2
MEANS AGEX2
DEFINE DOUBLED = AGE + AGE
MEANS DOUBLED
DEFINE OVER60 NUMERIC
IF AGE > 60 THEN
ASSIGN OVER60 = AGE * 10
ELSE
ASSIGN OVER60 = 0
END
FREQ OVER60
DEFINE BIGAGE NUMERIC
IF AGE > 60 THEN
ASSIGN BIGAGE = AGE
END
DEFINE BIGPLUS NUMERIC
ASSIGN BIGPLUS = BIGAGE + 1
FREQ BIGAGE
MEANS BIGPLUS
DEFINE TMISS NUMERIC
IF TIMESUPPER = (.) THEN
ASSIGN TMISS = 1
ELSE
ASSIGN TMISS = 0
END
FREQ TMISS
DEFINE SICKTXT TEXTINPUT
IF ILL = 1 THEN
ASSIGN SICKTXT = "yes"
ELSE
ASSIGN SICKTXT = "no"
END
FREQ SICKTXT
UNDEFINE AGEX2
DISPLAY DBVARIABLES
CLOSEOUT
QUIT
