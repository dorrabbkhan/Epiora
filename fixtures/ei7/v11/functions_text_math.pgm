*** functions_text_math.pgm — Epiora v1.1 Task 3 reference program.
*** Text and math functions over Nutrition.mdb's PatientVisits2 (11 rows):
*** UPPERCASE, SUBSTRING, STRLEN, TXTTONUM, FINDTEXT, FORMAT; ROUND, TRUNC,
*** ABS, EXP, LN, SQRT — AgeMonths, BMI and WeightPounds each have one
*** missing cell, so missing propagation through functions is pinned too.
READ '@WORK_DIR@/Nutrition.mdb':PatientVisits2
ROUTEOUT "@OUTPUT_HTML@" REPLACE
DEFINE UPNAME TEXTINPUT
ASSIGN UPNAME = UPPERCASE(Name)
DEFINE SUBNM TEXTINPUT
ASSIGN SUBNM = SUBSTRING(Name, 1, 3)
DEFINE NMLEN NUMERIC
ASSIGN NMLEN = STRLEN(Name)
DEFINE PIDNUM NUMERIC
ASSIGN PIDNUM = TXTTONUM(VisitPatientID)
DEFINE RNDAGE NUMERIC
ASSIGN RNDAGE = ROUND(AgeMonths, 0)
DEFINE TRAGE NUMERIC
ASSIGN TRAGE = TRUNC(-7.5)
DEFINE ABSZ NUMERIC
ASSIGN ABSZ = ABS(0 - HeightInches)
DEFINE EXPLN NUMERIC
ASSIGN EXPLN = EXP(LN(HeightInches))
DEFINE SQV NUMERIC
ASSIGN SQV = SQRT(HeightInches)
DEFINE FMTH TEXTINPUT
ASSIGN FMTH = FORMAT(HeightInches, "0.00")
DEFINE FINDN NUMERIC
ASSIGN FINDN = FINDTEXT("John", Name)
LIST Name UPNAME SUBNM NMLEN PIDNUM RNDAGE TRAGE ABSZ EXPLN SQV FMTH FINDN
CLOSEOUT
QUIT
