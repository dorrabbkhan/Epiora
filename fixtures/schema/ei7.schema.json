{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Epi Info 7 reference output",
  "description": "Numbers extracted by fixtures/ei7/parse.mjs from Epi Info 7's own ROUTEOUT html. Two shapes: 'outputs' — labelled numbers per command block (spec §6.4, v0.2 Task 3, oswego.json); 'steps' — per-program-line rows and results for the v1.1 command corpus (spec §8.1, v1.1 Task 3, fixtures/ei7/v11/<topic>.json). Produced by the ei7 workflow on windows-latest, never hand-edited.",
  "type": "object",
  "oneOf": [
    {
      "required": ["source", "outputs"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "object",
          "required": ["build", "zip_sha256", "sample_mdb_sha256", "run_url"],
          "additionalProperties": false,
          "properties": {
            "build": {
              "type": "string",
              "minLength": 1
            },
            "zip_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "sample_mdb_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "run_url": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["command", "values"],
            "additionalProperties": false,
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["label", "key", "text", "value", "decimals"],
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "key": {
                      "type": ["string", "null"]
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": "number"
                    },
                    "decimals": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "required": ["source", "steps"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "object",
          "required": ["build", "zip_sha256", "run_url", "program", "inputs"],
          "additionalProperties": false,
          "properties": {
            "build": {
              "type": "string",
              "minLength": 1
            },
            "zip_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "run_url": {
              "type": "string",
              "minLength": 1
            },
            "program": {
              "type": "string",
              "minLength": 1
            },
            "inputs": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["line", "command", "rows", "results"],
            "additionalProperties": false,
            "properties": {
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "rows": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          { "type": "string" },
                          { "type": "number" },
                          { "type": "null" }
                        ]
                      }
                    }
                  },
                  { "type": "null" }
                ]
              },
              "results": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": ["value", "decimals"],
                  "additionalProperties": false,
                  "properties": {
                    "value": {
                      "type": "number"
                    },
                    "decimals": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
