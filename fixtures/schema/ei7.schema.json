{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Epi Info 7 reference output",
  "description": "Labelled numbers extracted by fixtures/ei7/parse.mjs from Epi Info 7's own ROUTEOUT html (spec §6.4). Produced by the ei7 workflow on windows-latest, never hand-edited.",
  "type": "object",
  "required": ["source", "outputs"],
  "additionalProperties": false,
  "properties": {
    "source": {
      "type": "object",
      "required": ["build", "zip_sha256", "sample_mdb_sha256", "run_url"],
      "additionalProperties": false,
      "properties": {
        "build": {
          "type": "string",
          "minLength": 1
        },
        "zip_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sample_mdb_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "run_url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command", "values"],
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "values": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "key", "text", "value", "decimals"],
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "key": {
                  "type": ["string", "null"]
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "number"
                },
                "decimals": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
