{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Epiora reference fixture v2",
  "description": "Reference values generated by fixtures/generate.R and consumed by engine tests. Fixture format v2 with tolerance classes (v0.2 Task 2, spec §6.2).",
  "type": "object",
  "required": ["id", "procedure", "inputs", "expected", "tolerance_classes", "source"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "procedure": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object"
    },
    "expected": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/node"
      }
    },
    "tolerance_classes": {
      "type": "object",
      "required": ["closed_form", "iterative"],
      "additionalProperties": false,
      "properties": {
        "closed_form": {
          "const": 1e-9
        },
        "iterative": {
          "const": 1e-6
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["r_version", "packages"],
      "additionalProperties": false,
      "properties": {
        "r_version": {
          "type": "string",
          "minLength": 1
        },
        "packages": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "procedure": {
            "const": "stratified_two_by_two"
          }
        },
        "required": ["procedure"]
      },
      "then": {
        "properties": {
          "inputs": {
            "type": "object",
            "required": ["strata", "labels"],
            "properties": {
              "strata": {
                "type": "array"
              },
              "labels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "procedure": {
            "const": "means"
          }
        },
        "required": ["procedure"]
      },
      "then": {
        "properties": {
          "inputs": {
            "type": "object",
            "required": ["dataset", "variable", "include_missing"],
            "properties": {
              "dataset": {
                "type": "string",
                "minLength": 1
              },
              "variable": {
                "type": "string",
                "minLength": 1
              },
              "group_by": {
                "type": "string",
                "minLength": 1
              },
              "include_missing": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "procedure": {
            "pattern": "^calc\\.[a-z0-9_]+$"
          }
        },
        "required": ["procedure"]
      },
      "then": {
        "properties": {
          "inputs": {
            "type": "object",
            "minProperties": 1
          }
        }
      }
    }
  ],
  "definitions": {
    "node": {
      "anyOf": [
        {
          "$ref": "#/definitions/leaf"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/node"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/node"
          }
        }
      ]
    },
    "leaf": {
      "type": "object",
      "required": ["value", "class"],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": ["number", "null"]
        },
        "class": {
          "enum": ["closed_form", "iterative"]
        },
        "r_default": {
          "type": "number"
        }
      }
    }
  }
}
