{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Epiora reference fixture",
  "description": "Reference values generated by fixtures/generate.R and consumed by engine tests. See the fixture JSON interface in the v0.1 plan Task 5.",
  "type": "object",
  "required": ["id", "procedure", "inputs", "expected", "tolerance", "source"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "procedure": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object"
    },
    "expected": {
      "type": "object"
    },
    "tolerance": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "source": {
      "type": "object",
      "required": ["package", "version", "r_version"],
      "additionalProperties": false,
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "r_version": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
